{
  "name": "turnero-fosa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.14.0",
  "types": "./ds-dist/index.d.ts",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:migrate": "prisma migrate deploy",
    "vercel-build": "prisma migrate deploy && tsx scripts/sync-preview-admin.ts && next build",
    "start": "next start",
    "postinstall": "prisma generate && node scripts/copy-zxing-wasm.mjs",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "test-data:load": "tsx scripts/load-test-data.ts development",
    "typecheck": "next typegen && tsc --noEmit",
    "release:check": "tsx scripts/check-release.ts",
    "ds:build": "tsc -p tsconfig.ds.json && node scripts/build-ds-css.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.29",
      "deepmerge-ts": "8.0.0",
      "mysql2": "3.23.1",
      "source-map-js": "1.2.2",
      "exceljs>uuid": "11.1.1"
    }
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "barcode-detector": "^3.2.2",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "next": "^16.3.7",
    "next-auth": "5.0.0-beta.32",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "uqr": "0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@fission-ai/openspec": "^1.13.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.7",
    "jsdom": "^30.1.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
