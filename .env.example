DATABASE_URL="postgresql://postgres:postgres@localhost:5432/turnero_fosa"
# Owner connection used ONLY by migrations; DATABASE_URL should use a separate restricted login.
MIGRATION_DATABASE_URL=""
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
RESEND_API_KEY="re_replace_with_resend_api_key"
EMAIL_FROM="Fosa Motos <turnos@example.com>"
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""
MERCADO_PAGO_ENVIRONMENT="test"
# Bearer token for the cron endpoints: /api/cron/deposits (deposit expiry and Mercado Pago
# reconciliation) and /api/cron/emails (email outbox retries).
CRON_SECRET=""
ADMIN_EMAIL="admin@example.com"
ADMIN_USERNAME="admin"
ADMIN_NAME="Fosa Admin"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key in the hosting secret manager and a protected backup; never rotate by overwriting it.
DATA_ENCRYPTION_KEY=""
# Public site key may be sent to the browser; the secret key must stay on the server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Override on preview deployments to their actual hostname (without scheme).
TURNSTILE_ALLOWED_HOSTNAME=""
# Comma-separated non-production database hosts allowed to receive test-data profiles.
TEST_DATA_ALLOWED_HOSTS=""
