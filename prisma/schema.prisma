generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ScheduleExceptionSource {
  IMPORTED
  MANUAL
}

enum ConfirmationMode {
  MANUAL
  AUTOMATIC
}

enum AppointmentStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum StaffRole {
  ADMIN
  STAFF
}

enum EmailLogStatus {
  PENDING
  SENT
  FAILED
}

enum DepositPaymentStatus {
  CREATED
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  REFUNDED
  CHARGED_BACK
  ERROR
}

model WorkshopSettings {
  id                       String             @id @default(cuid())
  workshopName             String
  capacity                 Int
  slotStepMinutes          Int
  minimumNoticeMinutes     Int
  maximumBookingWindowDays Int
  confirmationMode         ConfirmationMode   @default(MANUAL)
  cancellationEnabled      Boolean            @default(true)
  reschedulingEnabled      Boolean            @default(false)
  depositRequired          Boolean            @default(false)
  depositAmountCents       Int                @default(500000)
  depositExpirationMinutes Int                @default(30)
  publicPhone              String?
  whatsappNumber           String?
  publicAppUrl             String?
  emailFrom                String?
  depositRefundPolicy      String?
  depositActivationDate    String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  weeklySchedules          WeeklySchedule[]
  scheduleBreaks           ScheduleBreak[]
  dateExceptions           ScheduleDateException[]
  services                 Service[]
  vehicleTypes             VehicleType[]
}

model WeeklySchedule {
  id                 String           @id @default(cuid())
  workshopSettingsId String
  dayOfWeek          DayOfWeek
  opensAt            String
  closesAt           String
  isOpen             Boolean
  workshopSettings   WorkshopSettings @relation(fields: [workshopSettingsId], references: [id], onDelete: Cascade)

  @@index([workshopSettingsId, dayOfWeek])
}

model ScheduleBreak {
  id                 String           @id @default(cuid())
  workshopSettingsId String
  dayOfWeek          DayOfWeek
  startsAt           String
  endsAt             String
  workshopSettings   WorkshopSettings @relation(fields: [workshopSettingsId], references: [id], onDelete: Cascade)

  @@index([workshopSettingsId, dayOfWeek])
}

model ScheduleDateException {
  id                 String                  @id @default(cuid())
  workshopSettingsId String
  date               DateTime                @db.Date
  label              String?
  source             ScheduleExceptionSource @default(MANUAL)
  manualOverride     Boolean                 @default(false)
  isOpen             Boolean                 @default(false)
  opensAt            String?
  closesAt           String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  workshopSettings   WorkshopSettings        @relation(fields: [workshopSettingsId], references: [id], onDelete: Cascade)

  @@unique([workshopSettingsId, date])
  @@index([workshopSettingsId, date])
}

model Service {
  id                 String           @id @default(cuid())
  workshopSettingsId String
  name               String
  description        String?
  durationMinutes    Int
  isActive           Boolean          @default(true)
  displayOrder       Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  workshopSettings   WorkshopSettings @relation(fields: [workshopSettingsId], references: [id], onDelete: Cascade)
  appointments       Appointment[]

  @@index([workshopSettingsId, isActive, displayOrder])
}

model Customer {
  id           String        @id @default(cuid())
  fullName     String
  phone        String
  /// Identity key: digits of phone. Indexed so a returning customer is matched by lookup, not by
  /// scanning the table.
  phoneNormalized String?
  email        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  vehicles     Vehicle[]
  appointments Appointment[]

  @@index([phone])
  @@index([phoneNormalized])
  @@index([email])
}

model VehicleType {
  id                 String           @id @default(cuid())
  workshopSettingsId String
  name               String
  isActive           Boolean          @default(true)
  displayOrder       Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  workshopSettings   WorkshopSettings @relation(fields: [workshopSettingsId], references: [id], onDelete: Cascade)
  vehicles           Vehicle[]

  @@unique([workshopSettingsId, name])
  @@index([workshopSettingsId, isActive, displayOrder])
}

model Vehicle {
  id              String        @id @default(cuid())
  customerId      String
  vehicleTypeId   String
  brand           String
  model           String
  licensePlate    String?
  /// Identity key: uppercase alphanumerics of licensePlate. Unique where not null (see the index below).
  plateNormalized String?
  year            Int?
  /// Internal-only fields. Public booking never asks for these.
  vin             String?
  engineNumber    String?
  color           String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicleType     VehicleType   @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)
  appointments    Appointment[]
  ownerHistory    VehicleOwnerHistory[]
  plateChanges    VehiclePlateChange[]

  @@index([customerId])
  @@index([licensePlate])
  /// Also unique where not null, through a partial index Prisma cannot declare
  /// (migration 20260924150000_unique_vehicle_plate).
  @@index([plateNormalized])
}

/// A corrected plate. The plate identifies the unit, so every change is kept with who made it.
model VehiclePlateChange {
  id            String   @id @default(cuid())
  vehicleId     String
  previousPlate String?
  newPlate      String?
  changedById   String?
  changedAt     DateTime @default(now())
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  changedBy     User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([vehicleId, changedAt])
}

model VehicleOwnerHistory {
  id                 String    @id @default(cuid())
  vehicleId          String
  previousCustomerId String?
  newCustomerId      String
  reason             String
  changedAt          DateTime  @default(now())
  vehicle            Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, changedAt])
}

model Appointment {
  id                    String                     @id @default(cuid())
  publicCode            String                     @unique @default(dbgenerated("generate_appointment_public_code()"))
  serviceId             String
  customerId            String
  vehicleId             String
  startAt               DateTime
  endAt                 DateTime
  status                AppointmentStatus          @default(PENDING_CONFIRMATION)
  idempotencyKey        String                     @unique
  cancellationTokenHash String?
  notes                 String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  service               Service                    @relation(fields: [serviceId], references: [id])
  customer              Customer                   @relation(fields: [customerId], references: [id])
  vehicle               Vehicle                    @relation(fields: [vehicleId], references: [id])
  statusHistory         AppointmentStatusHistory[]
  intervalHistory       AppointmentIntervalHistory[]
  emailLogs             EmailLog[]
  paymentAttempts       DepositPaymentAttempt[]

  @@index([startAt, endAt, status])
  @@index([customerId])
  @@index([vehicleId])
}

model DepositPaymentAttempt {
  id                 String               @id @default(cuid())
  appointmentId      String
  provider           String               @default("MERCADO_PAGO")
  externalReference  String               @unique
  preferenceId       String?              @unique
  providerPaymentId  String?              @unique
  checkoutUrl        String?
  amountCents        Int
  currency           String               @default("ARS")
  status             DepositPaymentStatus @default(CREATED)
  statusDetail       String?
  liveMode           Boolean?
  expiresAt          DateTime
  approvedAt         DateTime?
  lastNotificationAt DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  appointment        Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@index([status, expiresAt])
}

model AppointmentIntervalHistory {
  id              String      @id @default(cuid())
  appointmentId   String
  previousStartAt DateTime
  previousEndAt   DateTime
  newStartAt      DateTime
  newEndAt        DateTime
  changedById     String?
  changedAt       DateTime    @default(now())
  reason          String?
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  changedBy       User?       @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([appointmentId, changedAt])
}

model AppointmentStatusHistory {
  id            String            @id @default(cuid())
  appointmentId String
  fromStatus    AppointmentStatus?
  toStatus      AppointmentStatus
  changedById   String?
  changedAt     DateTime          @default(now())
  note          String?
  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  changedBy     User?             @relation(fields: [changedById], references: [id])

  @@index([appointmentId, changedAt])
}

model User {
  id            String                     @id @default(cuid())
  name          String?
  username      String?                    @unique
  email         String                     @unique
  passwordHash  String?
  /// Staff can run the agenda, vehicles and inventory; only admins change how the workshop operates.
  role          StaffRole                  @default(STAFF)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  accounts      Account[]
  sessions      Session[]
  statusChanges AppointmentStatusHistory[]
  intervalChanges AppointmentIntervalHistory[]
  inventoryMovements InventoryMovement[]
  plateChanges    VehiclePlateChange[]
  stockCountsOpened StockCount[] @relation("StockCountOpenedBy")
  stockCountsClosed StockCount[] @relation("StockCountClosedBy")
  stockCountLines StockCountLine[]
}

enum InventoryMovementKind {
  INITIAL
  RECEIPT
  ADJUSTMENT
  REPAIR
}

model ShopProduct {
  id            String   @id @default(cuid())
  sku           String   @unique
  barcode       String?  @unique
  name          String
  description   String?
  category      String
  brand         String?
  compatibility String?
  location      String?
  priceCents    Int
  stock         Int      @default(0)
  reservedStock Int      @default(0)
  minimumStock  Int      @default(0)
  isActive      Boolean  @default(true)
  version       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  movements     InventoryMovement[]
  countLines    StockCountLine[]

  @@index([isActive, name])
  @@index([category])
}

model InventoryMovement {
  id                 String                @id @default(cuid())
  productId          String
  kind               InventoryMovementKind
  quantityDelta      Int
  stockBefore        Int
  stockAfter         Int
  reason             String
  reference          String?
  actorId            String?
  requestKey         String                @unique
  requestFingerprint String
  createdAt          DateTime              @default(now())
  product            ShopProduct           @relation(fields: [productId], references: [id], onDelete: Restrict)
  actor              User?                 @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
}

enum StockCountStatus {
  OPEN
  APPLIED
  CANCELLED
}

/// Physical stock count. While open it never changes stock; applying it records one adjustment per difference.
model StockCount {
  id          String           @id @default(cuid())
  title       String
  /// Null counts every product; otherwise only the products stored at this location.
  location    String?
  status      StockCountStatus @default(OPEN)
  openedById  String?
  closedById  String?
  closedAt    DateTime?
  closeReason String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  openedBy    User?            @relation("StockCountOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  closedBy    User?            @relation("StockCountClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  lines       StockCountLine[]

  @@index([status, createdAt])
}

/// One product in a count. `expectedStock` and `expectedMovements` are the baseline: if either
/// changed by the time the count is applied, the product moved while being counted and needs a recount.
model StockCountLine {
  id                String      @id @default(cuid())
  countId           String
  productId         String
  expectedStock     Int
  expectedMovements Int
  /// Null means not counted yet, which is different from counting zero.
  countedQuantity   Int?
  countedById       String?
  countedAt         DateTime?
  count             StockCount  @relation(fields: [countId], references: [id], onDelete: Cascade)
  product           ShopProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  countedBy         User?       @relation(fields: [countedById], references: [id], onDelete: SetNull)

  @@unique([countId, productId])
  @@index([productId])
}

/// Failed internal sign-ins per key ("user:<username>" or "ip:<address>"), shared by every server instance.
model LoginThrottle {
  key         String    @id
  failures    Int       @default(0)
  windowStart DateTime
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Email outbox: rows are written PENDING together with the change that owes the email, and a
/// dispatcher delivers them afterwards with retries, so a slow or failing provider never blocks a request.
model EmailLog {
  id            String         @id @default(cuid())
  appointmentId String?
  event         String
  recipient     String
  /// Null only on rows logged before the outbox existed, which are already SENT or FAILED.
  subject       String?
  body          String?
  status        EmailLogStatus @default(PENDING)
  attempts      Int            @default(0)
  /// When a PENDING row is next due; while a dispatcher holds it, the end of its lease.
  nextAttemptAt DateTime       @default(now())
  providerId    String?
  errorMessage  String?
  sentAt        DateTime?
  createdAt     DateTime       @default(now())
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
}
